# ==============================================================================
# IA Desk Agro - Archivo de Ejemplo de Variables de Entorno (.env.example)
# Todo el sistema funciona con servicios 100% GRATUITOS y Open Source
# ==============================================================================

# 1. Configuración del Servidor Django
DEBUG=True
SECRET_KEY=django-insecure-ia-desk-agro-local-secret-key-cambiar-en-produccion-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.ngrok-free.app,.trycloudflare.com,.onrender.com,.up.railway.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.ngrok-free.app,https://*.trycloudflare.com,https://*.onrender.com,https://*.up.railway.app
PORT=8000

# 2. WhatsApp Cloud API Oficial (Meta for Developers - Capa Gratuita Oficial)
# Hasta 1.000 conversaciones mensuales 100% gratuitas sin costo
# Configúralo en: https://developers.facebook.com/
WHATSAPP_VERIFY_TOKEN=ia_desk_agro_meta_verify_2026
WHATSAPP_API_TOKEN=EAAG...tu_token_temporal_o_permanente_aqui...
WHATSAPP_PHONE_NUMBER_ID=100609346426845
WHATSAPP_BUSINESS_ACCOUNT_ID=100609346426840

# 3. Proveedores de Inteligencia Artificial (Opcionales)
# Si no colocas claves, el sistema funciona en Modo Local Autónomo con cálculo agronómico INTA y Open-Meteo en vivo
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
ANTHROPIC_API_KEY=

# 4. Google Drive / Planillas (Opcional - Enlace a carpeta de visualización)
GOOGLE_DRIVE_FOLDER_ID=11XiJ4FtA-8KOU3BvZWr6yDbxOwVoUvkw
GOOGLE_SHEET_ID=
