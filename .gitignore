# ==============================================================================
# .gitignore - IA Desk Agro
# Proteccion de credenciales, entornos virtuales, bases de datos y temporales
# ==============================================================================

# Variables de entorno y secretos
.env
.env.*
*.env
.env.local
.env.production
.env.staging

# Claves privadas, certificados y credenciales de API / Servicios
*.pem
*.key
*.crt
*.cert
credentials.json
credentials*.json
client_secret*.json
service_account*.json
token.json
tokens.json
secrets.json

# Entornos virtuales de Python
venv/
.venv/
env/
ENV/

# Compilacion y cache de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Base de datos local SQLite
db.sqlite3
*.sqlite3
*.sqlite
*.db

# Backups locales
backups/
backups/*

# Archivos temporales de Office / Excel
~$*

# Archivos estaticos recolectados en produccion
staticfiles/

# Archivos del sistema operativo y editores
.DS_Store
.DS_Store?
._*
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.log
